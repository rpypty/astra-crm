COMPOSE_PROJECT_NAME=astra_dev

BACKEND_IMAGE=ghcr.io/rpypty/astra-crm-backend:dev
FRONTEND_IMAGE=ghcr.io/rpypty/astra-crm-frontend:dev

POSTGRES_DB=astra_crm_dev
POSTGRES_USER=astra_dev
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://astra_dev:change-me@postgres:5432/astra_crm_dev?sslmode=disable

APP_ENV=development
SESSION_COOKIE_NAME=astra_dev_session
SESSION_SECURE=true
CSRF_ALLOWED_ORIGINS=https://dev.paycrm.space
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW=1m

HOST_BACKEND_PORT=8082
HOST_FRONTEND_PORT=3002
