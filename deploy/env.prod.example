COMPOSE_PROJECT_NAME=astra_prod

BACKEND_IMAGE=ghcr.io/rpypty/astra-crm-backend:prod
FRONTEND_IMAGE=ghcr.io/rpypty/astra-crm-frontend:prod

POSTGRES_DB=astra_crm_prod
POSTGRES_USER=astra_prod
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://astra_prod:change-me@postgres:5432/astra_crm_prod?sslmode=disable

APP_ENV=production
SESSION_COOKIE_NAME=astra_prod_session
SESSION_SECURE=true
CSRF_ALLOWED_ORIGINS=https://astra.paycrm.space
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW=1m

HOST_BACKEND_PORT=8081
HOST_FRONTEND_PORT=3001
